<rml>
	<head>
		<title>tvhp</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="theme.rcss"/>
		<link type="text/rcss" href="css/layout.rcss"/>
		<link type="text/rcss" href="css/connect.rcss"/>
		<link type="text/rcss" href="css/guide.rcss"/>
		<link type="text/rcss" href="css/recordings.rcss"/>
		<link type="text/rcss" href="css/details.rcss"/>
		<link type="text/rcss" href="css/watch.rcss"/>
		<link type="text/rcss" href="css/menu.rcss"/>
	</head>
	<!-- Icons are glyphs of the Lucide font (src/icons.h), written here as
	     character references: &#xE195; tv, &#xE0D4; film, &#xE140; play,
	     &#xE132; pause, &#xE349; record, &#xE304; scheduled, &#xE157;
	     server, &#xE073; chevron, &#xE226; done, &#xE48A; now playing. -->
	<body data-model="tv" data-class-watching="watching && fullscreen"
	      data-class-behind="watching && !fullscreen"
	      data-class-blade="menu_open && !menu_dialog">

		<!-- A video playing on behind the menus (Back from full screen):
		     the shade the menus need over it to be read. -->
		<div id="video-shade" data-if="watching && !fullscreen"/>

		<!-- ============================ Connect ============================ -->
		<div id="connect-view" data-if="view == 'connect'">

			<div id="brand">
				<span class="brand-icon">&#xE195;</span>
				<span class="brand-name">tvhp</span>
				<span class="brand-tag">Tvheadend on your PlayStation</span>
			</div>

			<div id="servers" class="pane" data-class-active="dialog == ''">
				<div class="pane-head">
					<span class="eyebrow">SERVERS</span>
					<span class="count" data-if="server_count > 0">{{server_count}}</span>
				</div>
				<div id="server-list" class="list">
					<div class="server-row" data-for="srv : servers"
					     data-class-selected="it_index == sel_server"
					     data-event-click="select_server(it_index)">
						<div class="srvicon">&#xE157;</div>
						<div class="srvinfo">
							<div class="srvname">{{srv.name}}</div>
							<div class="srvdetail">{{srv.detail}}</div>
						</div>
						<div class="srvgo">&#xE073;</div>
					</div>
					<!-- After the servers: adding one, so a first run needs no
					     instructions. -->
					<div class="server-row add-row" data-class-selected="sel_server == server_count"
					     data-event-click="select_server(server_count)">
						<div class="srvicon">&#xE141;</div>
						<div class="srvinfo">
							<div class="srvname">Add a server</div>
							<div class="srvdetail">Tvheadend's address, port and login</div>
						</div>
						<div class="srvgo">&#xE073;</div>
					</div>
				</div>
				<div class="status" data-if="status != ''">{{status}}</div>
			</div>

		</div>

		<!-- Modal add/edit dialog, opened with the Options button -->
		<div id="server-dialog" data-if="dialog != ''">
			<div class="dialog-card">
				<div class="dialog-title">{{dialog_title}}</div>

				<div class="field">
					<div class="label" id="lbl-name">NAME</div>
					<input type="text" id="in-name" data-value="name"/>
				</div>
				<div class="field">
					<div class="label" id="lbl-host">HOSTNAME</div>
					<input type="text" id="in-host" data-value="host"/>
				</div>
				<div class="field">
					<div class="label" id="lbl-port">PORT</div>
					<input type="text" id="in-port" data-value="port"/>
				</div>
				<div class="field">
					<div class="label" id="lbl-user">USERNAME</div>
					<input type="text" id="in-user" data-value="user"/>
				</div>
				<div class="field">
					<div class="label" id="lbl-pass">PASSWORD</div>
					<input type="password" id="in-pass" data-value="pass"/>
				</div>

				<div class="dialog-buttons">
					<button id="btn-save" data-event-click="save">Save</button>
					<button id="btn-cancel" data-event-click="cancel">Cancel</button>
				</div>

				<div class="status" data-if="status != ''">{{status}}</div>
			</div>
		</div>

		<!-- ============================= Main ============================== -->
		<div id="main-view" data-if="view == 'main'">

			<div id="topbar">
				<!-- The two places, as tabs: Up from the top of a list onto
				     them, Left / Right to pick (or L1 / R1 from anywhere). -->
				<div id="tabs" data-class-focused="zone == 'tabs'">
					<div class="tab" data-class-selected="section == 'channels'"
					     data-event-click="select_section('channels')">
						<span class="tab-icon">&#xE195;</span><span class="tab-label">Guide</span>
					</div>
					<div class="tab" data-class-selected="section == 'recordings'"
					     data-event-click="select_section('recordings')">
						<span class="tab-icon">&#xE0D4;</span><span class="tab-label">Recordings</span>
					</div>
				</div>
				<span class="spacer"/>
				<span class="player-status" data-if="player_status != ''">{{player_status}}</span>
				<div class="clockbox">
					<div class="clock">{{clock}}</div>
					<div class="date">{{date}}</div>
				</div>
			</div>

			<div id="content">

				<!-- ==================== Channels ==================== -->
				<div id="channels" class="pane" data-if="section == 'channels'"
				     data-class-active="zone == 'channels'">
					<div class="pane-head">
						<span class="eyebrow">CHANNELS</span>
						<span class="count">{{channel_count}}</span>
					</div>
					<div id="channel-list" class="list">
						<div class="channel-row" data-for="ch : channels"
						     data-class-selected="it_index == sel_channel"
						     data-class-playing="ch.playing"
						     data-event-click="select_channel(it_index)">
							<div class="chnum">{{ch.number}}</div>
							<!-- The logo (Tvheadend's), or a TV symbol while there
							     is none. -->
							<div class="chlogo" data-if="ch.icon != 'none'"><div class="logo-img" data-style-decorator="ch.icon"/></div>
							<div class="chlogo empty" data-if="ch.icon == 'none'">&#xE195;</div>
							<div class="chinfo">
								<div class="chname">{{ch.name}}<span class="chlive" data-if="ch.playing">&#xE48A;</span></div>
								<div class="chnow">{{ch.now_title}}</div>
								<div class="progress" data-if="ch.has_now">
									<div class="bar" data-style-width="ch.progress_style"/>
								</div>
							</div>
							<div class="chtime" data-if="ch.has_now">{{ch.now_time}}</div>
						</div>
					</div>
				</div>

				<!-- Programme guide for the selected channel -->
				<div id="epg" class="pane" data-if="section == 'channels'"
				     data-class-active="zone == 'epg'">
					<div class="pane-head">
						<span class="eyebrow">GUIDE</span>
						<div class="headlogo" data-if="epg_icon != 'none'" data-style-decorator="epg_icon"/>
						<span class="count">{{epg_channel}}</span>
					</div>
					<div id="epg-list" class="list">
						<!-- NOTE: don't rename the iterator to "ev":
						     addresses starting with "ev." are reserved by
						     RmlUi for event parameters and silently bypass
						     data-for aliases. -->
						<div class="epg-row" data-for="prog : epg"
						     data-class-selected="it_index == sel_epg && zone == 'epg'"
						     data-class-now="prog.now"
						     data-class-rec="prog.recording"
						     data-event-click="select_epg(it_index)">
							<div class="evtime">{{prog.time}}</div>
							<div class="evtitle">{{prog.title}}</div>
							<div class="evbadge live" data-if="prog.rec == 'REC'">&#xE349; REC</div>
							<div class="evbadge sched" data-if="prog.rec != '' && prog.rec != 'REC'">&#xE304;</div>
							<div class="evday" data-if="prog.day != ''">{{prog.day}}</div>
							<div class="evday now" data-if="prog.now">NOW</div>
						</div>
					</div>

					<div class="detail-box">
						<div class="detail-title">{{detail_title}}</div>
						<div class="detail-meta" data-if="detail_meta != ''">{{detail_meta}}</div>
						<div class="detail-rec" data-if="detail_rec != ''">{{detail_rec}}</div>
						<div class="detail-desc">{{detail_desc}}</div>
					</div>
				</div>

				<!-- ==================== Recordings ==================== -->
				<div id="recordings" class="pane" data-if="section == 'recordings'"
				     data-class-active="zone == 'recordings'">
					<div class="pane-head">
						<span class="eyebrow">RECORDINGS</span>
						<span class="count">{{rec_count}}</span>
					</div>
					<div id="rec-list" class="list">
						<div class="rec-row" data-for="rec : recordings"
						     data-class-selected="it_index == sel_rec"
						     data-class-pending="rec.pending"
						     data-class-failed="rec.failed"
						     data-class-playing="rec.playing"
						     data-event-click="select_rec(it_index)">
							<div class="reclogo" data-if="rec.icon != 'none'"><div class="logo-img" data-style-decorator="rec.icon"/></div>
							<div class="reclogo empty" data-if="rec.icon == 'none'">&#xE0D4;</div>
							<div class="recinfo">
								<div class="rectitle">{{rec.title}}<span class="chlive" data-if="rec.playing">&#xE48A;</span></div>
								<div class="recmeta"><span class="recwatched" data-if="rec.watched">&#xE070; WATCHED</span>{{rec.meta}}</div>
								<!-- Left part-way: how far (Tvheadend keeps it). -->
								<div class="recprogress" data-if="rec.resumable">
									<div class="bar" data-style-width="rec.progress"/>
								</div>
							</div>
							<div class="recstate">{{rec.state}}</div>
						</div>
					</div>
				</div>

				<!-- Details for the selected recording -->
				<div id="recdetail" class="pane" data-if="section == 'recordings'">
					<div class="pane-head">
						<span class="eyebrow">DETAILS</span>
					</div>

					<div class="detail-box tall">
						<div class="detail-title">{{detail_title}}</div>
						<div class="detail-meta" data-if="detail_meta != ''">{{detail_meta}}</div>
						<div class="detail-rec" data-if="detail_rec != ''">{{detail_rec}}</div>
						<div class="detail-desc">{{detail_desc}}</div>
					</div>
				</div>

			</div>


		</div>

		<!-- ========================= Playback OSD ========================== -->

		<!-- A paused recording: a large badge in the middle, Kodi style. -->
		<div id="pause-badge" data-if="watching && fullscreen && watch_paused && !menu_open">&#xE132;</div>

		<!-- The bar along the bottom. Its top edge is the timeline: the
		     programme on air for live TV, the position in a recording, with a
		     knob at the playhead and, while seeking, how far in all. -->
		<div id="osd" data-if="watching && fullscreen && info_visible">
			<div class="osd-edge">
				<div class="osd-played" data-style-width="watch_progress"/>
				<div class="osd-knob" data-if="watch_recorded" data-style-left="watch_progress"/>
				<div class="osd-seek" data-if="watch_seek != ''" data-style-left="watch_seek_at">{{watch_seek}}</div>
			</div>
			<div class="osd-row">
				<div class="osd-logo" data-if="!watch_recorded && watch_icon != 'none'">
					<div class="osd-logo-img" data-style-decorator="watch_icon"/>
				</div>
				<div class="osd-glyph" data-if="!watch_recorded && watch_icon == 'none'">&#xE195;</div>
				<div class="osd-glyph" data-if="watch_recorded && watch_paused">&#xE132;</div>
				<div class="osd-glyph" data-if="watch_recorded && !watch_paused">&#xE140;</div>
				<div class="osd-main">
					<div class="osd-title">{{watch_name}}</div>
					<div class="osd-desc" data-if="watch_now != ''">{{watch_now}}</div>
					<!-- What is being decoded, and the settings that are on. -->
					<div class="osd-tracks">
						<span class="osd-track" data-if="watch_vtrack != ''">{{watch_vtrack}}</span>
						<span class="osd-track" data-if="watch_atrack != ''">{{watch_atrack}}</span>
						<span class="osd-track" data-if="watch_strack != ''">{{watch_strack}}</span>
						<span class="osd-track badge" data-if="watch_speed != ''">{{watch_speed}}</span>
						<span class="osd-track badge" data-if="watch_sleep != ''">{{watch_sleep}}</span>
					</div>
				</div>
				<div class="osd-side">
					<div class="osd-time">
						<span>{{watch_time}}</span>
					</div>
					<div class="osd-ends" data-if="watch_ends != ''">{{watch_ends}}</div>
					<div class="osd-status" data-if="player_status != ''">{{player_status}}</div>
				</div>
			</div>
		</div>

		<!-- The playback menu (Options while watching): a blade on the left.
		     Or, with menu_dialog, a question in the middle of the screen
		     (resume a recording?). Left/right change a setting, cross runs
		     an action, circle closes. -->
		<div id="menu-scrim" data-if="menu_open" data-class-dialog="menu_dialog"/>
		<div id="menu" data-if="menu_open" data-class-dialog="menu_dialog">
			<div class="menu-title">{{menu_title}}</div>
			<div class="dialog-meta" data-if="menu_dialog && menu_meta != ''">{{menu_meta}}</div>
			<div class="dialog-progress" data-if="menu_dialog && menu_progress != '0%'">
				<div class="dialog-played" data-style-width="menu_progress"/>
			</div>
			<div id="menu-rows">
				<div class="menu-row" data-for="m : menu"
				     data-class-selected="it_index == sel_menu">
					<span class="menu-label">{{m.label}}</span>
					<span class="menu-value" data-if="m.value != ''">‹  {{m.value}}  ›</span>
				</div>
			</div>
		</div>

		<!-- Toast -->
		<div id="toast" data-if="toast != ''">
			<span class="toast-icon" data-if="toast_icon != ''">{{toast_icon}}</span>
			<span class="toast-text">{{toast}}</span>
		</div>

	</body>
</rml>
