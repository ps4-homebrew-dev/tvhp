/*
 * The main screen's frame: the top bar (tabs, clock), the panes and their
 * lists, and the toast. No button hints, as on the PS4's own screens.
 */

/* Above the video shade, which is positioned. */
#main-view,
#connect-view {
	position: relative;
	z-index: 1;
}

#main-view {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
}

.spacer {
	display: block;
	flex: 1;
}

/* ------------------------------------------------------------------ */
/* Top bar                                                            */
/* ------------------------------------------------------------------ */

#topbar {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 124px;
	padding: 0px 64px;
}

/* Guide and Recordings. The one shown is lit, and amber while the tabs
 * have the focus. */
#tabs {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex-shrink: 0;
	padding: 6px 14px;
	background-color: #ffffff0a;
	border-radius: 32px;
}

.tab {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 52px;
	padding: 0px 28px 0px 22px;
	border-radius: 26px;
	color: #8593ab;
	white-space: nowrap;
}

.tab-icon {
	margin-right: 12px;
	font-size: 26px;
}

.tab-label {
	font-size: 24px;
	font-weight: bold;
}

.tab.selected {
	color: #e8edf7;
	background-color: #ffffff1f;
}

#tabs.focused {
	background-color: #ffffff14;
}
#tabs.focused .tab.selected {
	color: #241604;
	decorator: linear-gradient(90deg, #f7c26c 0%, #e9a13c 100%);
	box-shadow: #f5b45340 0px 4px 18px 0px;
}

#topbar .player-status {
	flex-shrink: 0;
	margin-right: 24px;
	font-size: 21px;
	color: #ff8f8f;
	white-space: nowrap;
}

/* Menus, dialogs, the info bar. */
@keyframes fade-in {
	from { opacity: 0; }
	to   { opacity: 1; }
}

#topbar .clockbox {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	flex-shrink: 0;
	white-space: nowrap;
}

#topbar .clock {
	font-size: 46px;
	font-weight: bold;
	color: #e8edf7;
}

#topbar .date {
	font-size: 20px;
	color: #8593ab;
}

/* ------------------------------------------------------------------ */
/* Content                                                            */
/* ------------------------------------------------------------------ */

#content {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	flex: 1;
	padding: 0px 64px 48px 64px;
	overflow: hidden;
}

/* ------------------------------------------------------------------ */
/* Panes                                                              */
/* ------------------------------------------------------------------ */

.pane {
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}

#channels {
	width: 700px;
	margin-right: 40px;
}

#epg {
	flex: 1;
}

.pane-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 52px;
	margin-bottom: 10px;
	padding: 0px 8px;
}

.eyebrow {
	display: inline-block;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 4px;
	color: #5a6478;
}

.pane.active .eyebrow {
	color: #f5b453;
}

.pane-head .count {
	display: inline-block;
	margin-left: 16px;
	padding: 2px 12px;
	font-size: 19px;
	font-weight: bold;
	color: #8593ab;
	background-color: #ffffff0d;
	border-radius: 12px;
	white-space: nowrap;
	overflow: hidden;
}

.list {
	flex: 1;
	overflow-x: hidden;
	overflow-y: auto;
}

.list scrollbarvertical {
	width: 6px;
}

.list scrollbarvertical slidertrack {
	background-color: #ffffff05;
	border-radius: 3px;
}

.list scrollbarvertical sliderbar {
	background-color: #ffffff2a;
	border-radius: 3px;
}

.list scrollbarvertical sliderarrowdec,
.list scrollbarvertical sliderarrowinc {
	width: 0px;
	height: 0px;
}

/* ------------------------------------------------------------------ */
/* Toast                                                              */
/* ------------------------------------------------------------------ */

#toast {
	z-index: 20;
	position: absolute;
	top: 132px; /* under the clock */
	right: 56px;
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	max-width: 820px;
	padding: 18px 30px 18px 28px;
	background-color: #151d2ff2;
	/* The accent as an inset shadow: a border on one side of a rounded box
	   tapers along its corners into a ragged tip. */
	border-radius: 14px;
	box-shadow: #f5b453 6px 0px 0px 0px inset, #00000080 0px 10px 30px 0px;
	animation: 0.25s cubic-out toast-in;
}

/* Clear of the menu blade. */
body.blade #toast {
	right: 700px;
}

@keyframes toast-in {
	from { opacity: 0; transform: translateX(40px); }
	to   { opacity: 1; transform: translateX(0px); }
}

.toast-icon {
	margin-right: 16px;
	font-size: 28px;
	color: #f5b453;
}

.toast-text {
	font-size: 26px;
	font-weight: bold;
	color: #e8edf7;
}

/* A channel's logo as a heading, after GUIDE. */
.headlogo {
	width: 72px;
	height: 36px;
	margin-left: 18px;
}
