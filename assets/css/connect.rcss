/*
 * Connect screen: the saved-server list, the add/edit dialog, and the
 * form field and button styles they share.
 */

/* ------------------------------------------------------------------ */
/* Connect screen                                                     */
/* ------------------------------------------------------------------ */

#connect-view {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 100%;
}

/* The app's name over the list. */
#brand {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 900px;
	margin-bottom: 40px;
}

.brand-icon {
	box-sizing: border-box;
	width: 84px;
	height: 84px;
	margin-right: 26px;
	padding-top: 14px;
	font-size: 48px;
	text-align: center;
	color: #241604;
	decorator: linear-gradient(135deg, #f7c26c 0%, #e9a13c 100%);
	border-radius: 22px;
	box-shadow: #f5b45340 0px 10px 30px 0px;
}

.brand-name {
	font-size: 56px;
	font-weight: bold;
	color: #ffffff;
}

.brand-tag {
	margin-left: 24px;
	padding-top: 14px;
	font-size: 24px;
	color: #8593ab;
}

#servers {
	box-sizing: border-box;
	width: 900px;
	height: 620px;
	padding: 24px 24px 18px 24px;
	background-color: #ffffff06;
	border: 1px #ffffff10;
	border-radius: 24px;
}

.server-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 96px;
	margin-bottom: 12px;
	margin-right: 12px;
	padding: 0px 26px 0px 16px;
	background-color: #ffffff07;
	border-radius: 16px;
	cursor: pointer;
}

.server-row:hover {
	background-color: #ffffff0e;
}

.srvicon {
	box-sizing: border-box;
	width: 64px;
	height: 64px;
	margin-right: 22px;
	padding-top: 14px;
	font-size: 32px;
	text-align: center;
	color: #f5b453;
	background-color: #f5b4531a;
	border-radius: 14px;
}

.srvinfo {
	display: block;
	flex: 1;
	overflow: hidden;
}

.srvname {
	display: block;
	font-size: 30px;
	font-weight: bold;
	color: #e8edf7;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.srvdetail {
	display: block;
	margin-top: 4px;
	font-size: 21px;
	color: #8593ab;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* The way in, on the selected row. */
.srvgo {
	font-size: 34px;
	color: #241604;
	visibility: hidden;
}

.server-row.selected {
	background-color: #ffffff17;
}

#servers.active .server-row.selected {
	decorator: linear-gradient(90deg, #f7c26c 0%, #e9a13c 100%);
	box-shadow: #f5b45338 0px 6px 24px 0px;
}
#servers.active .server-row.selected .srvname {
	color: #241604;
}
#servers.active .server-row.selected .srvdetail {
	color: #5a3c0e;
}
#servers.active .server-row.selected .srvicon {
	color: #241604;
	background-color: #00000024;
}
#servers.active .server-row.selected .srvgo {
	visibility: visible;
}

/* ------------------------------------------------------------------ */
/* Add / edit server dialog (Options button)                          */
/* ------------------------------------------------------------------ */

/* Over the list, which shows through blurred. */
#server-dialog {
	position: absolute;
	top: 0px;
	left: 0px;
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	background-color: #060a14b0;
	backdrop-filter: blur(14px);
	z-index: 15;
	animation: 0.2s cubic-out fade-in;
}

.dialog-card {
	box-sizing: border-box;
	width: 760px;
	padding: 44px 52px 40px 52px;
	background-color: #141c2ef5;
	border: 1px #ffffff1c;
	border-radius: 26px;
	box-shadow: #000000a0 0px 24px 70px 0px;
	animation: 0.2s cubic-out dialog-in;
}

.dialog-title {
	display: block;
	margin-bottom: 32px;
	font-size: 40px;
	font-weight: bold;
	color: #ffffff;
}

.field {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 20px;
}

.field .label {
	box-sizing: border-box;
	display: block;
	width: 210px;
	margin-right: 18px;
	padding: 10px 14px;
	font-size: 18px;
	font-weight: bold;
	letter-spacing: 3px;
	color: #8593ab;
	border: 2px #ffffff00;
	border-radius: 10px;
	tab-index: auto;
}

.field .label:focus {
	color: #f5b453;
	border: 2px #f5b453;
	background-color: #f5b45314;
}

input.text, input.password {
	box-sizing: border-box;
	display: block;
	width: auto;
	flex: 1;
	padding: 16px 20px;
	font-size: 28px;
	color: #e8edf7;
	background-color: #0b1020;
	border: 2px #ffffff1c;
	border-radius: 12px;
	tab-index: auto;
	caret-color: #f5b453;
}

input.text:focus, input.password:focus {
	border: 2px #f5b453;
	background-color: #0b1020;
	box-shadow: #f5b45330 0px 0px 0px 4px;
}

input.text selection, input.password selection {
	color: #241604;
	background-color: #f5b453;
}

button {
	box-sizing: border-box;
	display: block;
	width: 100%;
	margin-top: 12px;
	padding: 18px 0px;
	font-size: 28px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;
	color: #e8edf7;
	background-color: #ffffff12;
	border-radius: 14px;
	tab-index: auto;
	cursor: pointer;
}

button:focus, button:hover {
	color: #241604;
	decorator: linear-gradient(90deg, #f7c26c 0%, #e9a13c 100%);
	box-shadow: #f5b45340 0px 6px 22px 0px;
}

.dialog-buttons {
	display: block;
	margin-top: 18px;
}

.dialog-buttons button {
	display: inline-block;
	width: 48%;
	margin-top: 0px;
}

.dialog-buttons #btn-save {
	margin-right: 4%;
}

button span {
	display: inline;
}

#servers .status,
.dialog-card .status {
	display: block;
	margin-top: 20px;
	font-size: 23px;
	text-align: center;
	color: #ff8f6e;
}

.connect-hints {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 32px;
}
