/*
 * The shared detail box used by the guide and the recordings view.
 */

.detail-box {
	box-sizing: border-box;
	display: block;
	height: 272px;
	margin-top: 24px;
	padding: 30px 36px;
	background-color: #ffffff08;
	border: 1px #ffffff12;
	border-radius: 18px;
	overflow: hidden;
}

/* The recordings pane has no list above it, so its detail box gets the
 * space instead. */
.detail-box.tall {
	flex: 1;
	height: auto;
	margin-top: 0px;
	margin-bottom: 8px;
}

.detail-title {
	display: block;
	font-size: 34px;
	font-weight: bold;
	color: #ffffff;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.detail-meta {
	display: block;
	margin-top: 8px;
	font-size: 22px;
	color: #f5b453;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* State: "Recording scheduled", "58 min · Resume from 20:34". */
.detail-rec {
	box-sizing: border-box;
	display: inline-block;
	margin-top: 14px;
	padding: 6px 16px;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 1px;
	color: #f7c26c;
	background-color: #f5b4531c;
	border-radius: 10px;
}

.detail-desc {
	display: block;
	margin-top: 18px;
	font-size: 24px;
	line-height: 1.45em;
	color: #aab6cc;
	overflow: hidden;
}
