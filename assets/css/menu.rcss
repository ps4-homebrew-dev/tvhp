/*
 * The Options menu: a blade over the right edge, as on the PS4, with what
 * can be done with the selected item, or the playback settings while
 * watching (and over a video playing behind the menus); or
 * (#menu.dialog) a small dialog in the middle of the screen for a question
 * that needs an answer first (resume?). Left / right change a setting in
 * place, cross runs an action, circle closes.
 *
 * jtplay's, in tvhp's colours. Row height and margin are mirrored by
 * kMenuRowPitch in src/app_internal.h.
 */

/* Stacking, bottom to top: video shade 0, menus 1, pause badge 4, OSD 5,
 * menu 10, server dialog 15, toast 20. */
#menu-scrim {
	z-index: 9;
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
	background-color: #05080f60;
	animation: 0.18s cubic-out fade-in;
}
#menu-scrim.dialog {
	background-color: #05080fa0;
	backdrop-filter: blur(10px);
}

/* On the right, where the PS4's own Options menu comes in. */
#menu {
	z-index: 10;
	position: absolute;
	right: 0px;
	top: 0px;
	bottom: 0px;
	box-sizing: border-box;
	width: 660px;
	padding: 72px 40px;
	display: flex;
	flex-direction: column;
	decorator: linear-gradient(270deg, #141c2e 0%, #10172a 100%);
	border-left: 1px #ffffff14;
	box-shadow: #000000a0 -20px 0px 60px 0px;
	animation: 0.18s cubic-out blade-in;
}

@keyframes blade-in {
	from { transform: translateX(80px); opacity: 0; }
	to   { transform: translateX(0px); opacity: 1; }
}

.menu-title {
	margin: 0px 0px 36px 24px;
	font-size: 30px;
	font-weight: bold;
	color: #ffffff;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* Long menus scroll; the app keeps the selection in view. */
#menu-rows {
	flex: 1;
	overflow-y: hidden;
}
#menu.dialog #menu-rows {
	flex: none;
}

.menu-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 72px;
	margin-bottom: 6px;
	padding: 0px 24px;
	border-radius: 12px;
}

.menu-label {
	flex: 1;
	font-size: 28px;
	color: #c5cee0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* The value is what changes with left / right: keep it visible. */
.menu-value {
	max-width: 340px;
	font-size: 24px;
	color: #8593ab;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.menu-row.selected {
	decorator: linear-gradient(90deg, #f7c26c 0%, #e9a13c 100%);
	box-shadow: #f5b45338 0px 6px 22px 0px;
}
.menu-row.selected .menu-label { color: #241604; font-weight: bold; }
.menu-row.selected .menu-value { color: #5a3c0e; }

/* ------------------------------------------------------------------ */
/* Dialog                                                             */
/* ------------------------------------------------------------------ */

/* Glass over what it interrupts, one border all around. (A border on one
 * side of a rounded box tapers along its corners into a ragged sliver.) */
#menu.dialog {
	left: 50%;
	top: 50%;
	bottom: auto;
	width: 760px;
	margin-left: -380px;
	margin-top: -210px;
	padding: 40px 48px 32px 48px;
	right: auto;
	border-left-width: 0px;
	border: 1px #ffffff1f;
	border-radius: 26px;
	decorator: none;
	background-color: #141c2ef0;
	box-shadow: #000000a0 0px 24px 70px 0px;
	animation: 0.2s cubic-out dialog-in;
}

@keyframes dialog-in {
	from { transform: scale(0.94); opacity: 0; }
	to   { transform: scale(1); opacity: 1; }
}

#menu.dialog .menu-title {
	margin: 0px 0px 28px 0px;
	font-size: 34px;
	text-align: center;
}

#menu.dialog .menu-row {
	justify-content: center;
	border-radius: 14px;
}

#menu.dialog .menu-label {
	flex: none;
}

/* Resume: where it was left, as text and as a bar like the player's. */
.dialog-meta {
	margin: -18px 0px 28px 0px;
	font-size: 22px;
	color: #8593ab;
	text-align: center;
}

.dialog-progress {
	position: relative;
	height: 6px;
	margin: -6px 0px 30px 0px;
	background-color: #ffffff1f;
	border-radius: 3px;
}

.dialog-played {
	position: absolute;
	left: 0px;
	top: 0px;
	height: 6px;
	decorator: linear-gradient(90deg, #e09a37 0%, #f5b453 100%);
	border-radius: 3px;
}
