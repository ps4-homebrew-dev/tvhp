/*
 * Channel list and programme guide rows.
 *
 * Row heights + margins are the pitches in src/app_internal.h.
 *
 * In the pane with the focus, the selection is the accent bar; the other
 * pane's is a lighter row, so it is clear which channel the guide is for.
 */

/* ------------------------------------------------------------------ */
/* Channel rows (96 + 12, kChannelRowPitch)                           */
/* ------------------------------------------------------------------ */

.channel-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 96px;
	margin-bottom: 12px;
	margin-right: 12px;
	padding: 0px 24px 0px 14px;
	background-color: #ffffff07;
	border-radius: 14px;
	cursor: pointer;
}

.channel-row:hover {
	background-color: #ffffff0e;
}

/* The channel's logo on a tile. */
.chlogo {
	box-sizing: border-box;
	flex-shrink: 0;
	width: 120px;
	height: 68px;
	margin-right: 22px;
	padding: 10px 14px;
	background-color: #ffffff0b;
	border-radius: 12px;
}

/* No logo (yet): the tile holds the channel's number, in its place. */
.chlogo.number {
	padding: 0px;
	font-size: 36px;
	font-weight: bold;
	line-height: 68px;
	text-align: center;
	color: #c5cee0;
	white-space: nowrap;
	overflow: hidden;
}

/* Nor a number: a TV. */
.chlogo.empty {
	padding: 0px;
	font-size: 34px;
	line-height: 68px;
	text-align: center;
	color: #ffffff2e;
}

.logo-img {
	width: 100%;
	height: 100%;
}

.chinfo {
	display: block;
	flex: 1;
	margin-right: 18px;
	overflow: hidden;
}

.chname {
	display: block;
	font-size: 30px;
	font-weight: bold;
	color: #e8edf7;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* On screen now (behind the menus). */
.chlive {
	margin-left: 14px;
	font-size: 26px;
	font-weight: normal;
	color: #ff6b6b;
}

.chnow {
	display: block;
	margin-top: 2px;
	font-size: 22px;
	color: #8593ab;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.progress {
	display: block;
	width: 100%;
	height: 6px;
	margin-top: 10px;
	background-color: #ffffff12;
	border-radius: 3px;
}

.progress .bar {
	display: block;
	height: 6px;
	decorator: linear-gradient(90deg, #e9a13c 0%, #f7c26c 100%);
	border-radius: 3px;
}

.chtime {
	display: block;
	width: 170px;
	font-size: 21px;
	text-align: right;
	color: #6f7b92;
	white-space: nowrap;
}

/* Selected while the guide has focus: a lighter row. */
.channel-row.selected {
	background-color: #ffffff17;
}
.channel-row.selected .chlogo.number {
	color: #ffffff;
}
.channel-row.selected .chlogo {
	background-color: #ffffff1a;
}
.channel-row.selected .chnow,
.channel-row.selected .chtime {
	color: #aab6cc;
}

/* Selected in the focused channel list: the accent bar. */
#channels.active .channel-row.selected {
	decorator: linear-gradient(90deg, #f7c26c 0%, #e9a13c 100%);
	box-shadow: #f5b45338 0px 6px 24px 0px;
}
/* Logos are drawn for dark backgrounds: on the amber bar, the tile stays
 * dark. */
#channels.active .channel-row.selected .chlogo {
	background-color: #0b1020e0;
}
#channels.active .channel-row.selected .chname,
#channels.active .channel-row.selected .chlive {
	color: #241604;
}
#channels.active .channel-row.selected .chnow,
#channels.active .channel-row.selected .chtime {
	color: #5a3c0e;
}
#channels.active .channel-row.selected .progress {
	background-color: #00000026;
}
#channels.active .channel-row.selected .progress .bar {
	decorator: none;
	background-color: #241604c0;
}

/* ------------------------------------------------------------------ */
/* EPG rows (76 + 10, kEpgRowPitch)                                   */
/* ------------------------------------------------------------------ */

.epg-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 76px;
	margin-bottom: 10px;
	margin-right: 12px;
	padding: 0px 22px 0px 22px;
	background-color: #ffffff06;
	border-radius: 12px;
	cursor: pointer;
}

.epg-row:hover {
	background-color: #ffffff0d;
}

.evtime {
	display: block;
	width: 210px;
	font-size: 24px;
	color: #8593ab;
	white-space: nowrap;
}

.evtitle {
	display: block;
	flex: 1;
	font-size: 26px;
	color: #c4cddd;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* What is on now: brighter, with the red NOW pill. */
.epg-row.now {
	background-color: #ffffff0c;
}
.epg-row.now .evtime,
.epg-row.now .evtitle {
	color: #ffffff;
	font-weight: bold;
}

/* Day changes, and NOW. */
.evday {
	box-sizing: border-box;
	display: inline-block;
	margin-left: 16px;
	padding: 5px 13px;
	font-size: 17px;
	font-weight: bold;
	letter-spacing: 2px;
	color: #8593ab;
	background-color: #ffffff0f;
	border-radius: 8px;
	white-space: nowrap;
}

.evday.now {
	color: #ffffff;
	background-color: #e04848;
}

/* Recording markers: REC on air (red), scheduled (the calendar). */
.evbadge {
	box-sizing: border-box;
	display: inline-block;
	margin-left: 14px;
	white-space: nowrap;
}

.evbadge.live {
	padding: 5px 12px;
	font-size: 17px;
	font-weight: bold;
	letter-spacing: 2px;
	color: #ffffff;
	background-color: #e04848;
	border-radius: 8px;
}

.evbadge.sched {
	font-size: 26px;
	color: #ff8f8f;
}

.epg-row.rec .evtitle {
	color: #e8edf7;
}

/* Selected in the focused guide: the accent bar, dark text. */
.epg-row.selected {
	decorator: linear-gradient(90deg, #f7c26c 0%, #e9a13c 100%);
	box-shadow: #f5b45338 0px 6px 24px 0px;
}
.epg-row.selected .evtitle {
	color: #241604;
	font-weight: bold;
}
.epg-row.selected .evtime {
	color: #5a3c0e;
}
.epg-row.selected .evday {
	color: #241604;
	background-color: #00000024;
}
.epg-row.selected .evbadge.sched {
	color: #8a1d1d;
}
