/*
 * The recordings. Row height + margin is kRecRowPitch (src/app_internal.h).
 */

#recordings {
	width: 880px;
	margin-right: 40px;
}

#recdetail {
	flex: 1;
}

.rec-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 104px;
	margin-bottom: 12px;
	margin-right: 12px;
	padding: 0px 26px 0px 18px;
	background-color: #ffffff07;
	border-radius: 14px;
	cursor: pointer;
}

.rec-row:hover {
	background-color: #ffffff0e;
}

/* The channel it was recorded from. */
.reclogo {
	box-sizing: border-box;
	flex-shrink: 0;
	width: 120px;
	height: 68px;
	margin-right: 24px;
	padding: 10px 14px;
	background-color: #ffffff0b;
	border-radius: 12px;
}

.reclogo.empty {
	padding: 0px;
	font-size: 32px;
	line-height: 68px;
	text-align: center;
	color: #ffffff2e;
}

#recordings.active .rec-row.selected .reclogo {
	background-color: #0b1020e0;
}

.recinfo {
	display: block;
	flex: 1;
	margin-right: 18px;
	overflow: hidden;
}

.rectitle {
	display: block;
	font-size: 29px;
	font-weight: bold;
	color: #e8edf7;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.recmeta {
	display: block;
	margin-top: 4px;
	font-size: 21px;
	color: #8593ab;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.recstate {
	box-sizing: border-box;
	display: block;
	width: 220px;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: right;
	color: #6f7b92;
	white-space: nowrap;
	overflow: hidden;
}

.rec-row.pending .recstate {
	color: #ff8f8f;
}

.rec-row.failed .recstate {
	color: #ff8f6e;
}

/* Left part-way: how far. */
.recprogress {
	display: block;
	width: 100%;
	height: 5px;
	margin-top: 8px;
	background-color: #ffffff12;
	border-radius: 3px;
}

.recprogress .bar {
	display: block;
	height: 5px;
	decorator: linear-gradient(90deg, #e9a13c 0%, #f7c26c 100%);
	border-radius: 3px;
}

/* Watched to the end at least once. */
.recwatched {
	margin-right: 12px;
	padding: 2px 10px;
	font-size: 15px;
	font-weight: bold;
	letter-spacing: 2px;
	color: #7fd1a0;
	background-color: #7fd1a01f;
	border-radius: 7px;
}

/* Selection: the accent bar while the list has focus. */
.rec-row.selected {
	background-color: #ffffff17;
}

#recordings.active .rec-row.selected {
	decorator: linear-gradient(90deg, #f7c26c 0%, #e9a13c 100%);
	box-shadow: #f5b45338 0px 6px 24px 0px;
}
#recordings.active .rec-row.selected .rectitle,
#recordings.active .rec-row.selected .chlive {
	color: #241604;
}
#recordings.active .rec-row.selected .recmeta,
#recordings.active .rec-row.selected .recstate {
	color: #5a3c0e;
}
#recordings.active .rec-row.selected .recwatched {
	color: #1f4d33;
	background-color: #00000020;
}
#recordings.active .rec-row.selected .recprogress {
	background-color: #00000026;
}
#recordings.active .rec-row.selected .recprogress .bar {
	decorator: none;
	background-color: #241604c0;
}
