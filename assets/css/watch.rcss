/*
 * Watch mode: hides the UI chrome so the video shows through, and styles
 * the auto-hiding info bar over it.
 */

/* ------------------------------------------------------------------ */
/* Watch mode (full-screen video)                                     */
/* ------------------------------------------------------------------ */

/* Let the video drawn beneath the UI show through. */
body.watching {
	background-color: transparent;
	decorator: none;
}
body.watching #topbar,
body.watching #content,
body.watching #footer {
	display: none;
}

/* Over the picture, notices go to the top, clear of the info bar and the
 * seek bubble. */
body.watching #toast {
	top: 60px;
	bottom: auto;
}

#watch-bar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: column;
	padding: 36px 56px 44px 56px;
	background-color: #0a0e18d8;
	border-top: 2px #ffffff14;
}

/* The channel number, title block and clock share one row; the progress
 * bar is a sibling below them so it can span the bar's full width. */
.watch-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.watch-num {
	font-size: 84px;
	font-weight: bold;
	color: #f5b453;
	margin-right: 40px;
}

/* Playing a recording: the channel-number slot becomes a play/pause glyph. */
.watch-num.transport {
	font-size: 60px;
	width: 96px;
	text-align: center;
	color: #e8edf7;
}

.watch-main {
	display: flex;
	flex-direction: column;
	flex: 1;
	margin-right: 40px;
}

.watch-name {
	font-size: 40px;
	font-weight: bold;
	color: #e8edf7;
}

.watch-now {
	margin-top: 6px;
	font-size: 30px;
	color: #8593ab;
}

.watch-progress {
	display: block;
	position: relative;
	margin-top: 24px;
	width: 100%;
	height: 8px;
	background-color: #ffffff1a;
}
.watch-progress .bar {
	display: block;
	height: 8px;
	background-color: #f5b453;
}

.watch-side {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
}

.watch-time {
	font-size: 30px;
	color: #e8edf7;
}

.watch-status {
	margin-top: 6px;
	font-size: 22px;
	letter-spacing: 2px;
	color: #8593ab;
}

.watch-ends {
	margin-top: 6px;
	font-size: 22px;
	color: #8593ab;
}

/* Seeking: how far the presses so far have jumped, riding on the bar. The
 * app positions its left edge (240px wide; see UpdateWatchOverlay). */
.watch-seek {
	position: absolute;
	bottom: 20px;
	box-sizing: border-box;
	width: 240px;
	padding: 8px 0px;
	font-size: 28px;
	font-weight: bold;
	text-align: center;
	color: #10131c;
	background-color: #f5b453;
}

/* The tracks being decoded and the settings that are on, as chips, with
 * the hint for the playback menu at the far end. */
.watch-tracks {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 20px;
}

.watch-track {
	margin-right: 14px;
	padding: 6px 14px;
	font-size: 20px;
	color: #a9b4c8;
	background-color: #ffffff10;
	white-space: nowrap;
}

.watch-track.badge {
	color: #10131c;
	background-color: #f5b453;
	font-weight: bold;
}

.watch-tracks .spacer {
	flex: 1;
}

.watch-tracks .hint {
	margin-right: 0px;
}

/* A button without icon art: its name on a keycap. */
.keycap {
	padding: 4px 10px;
	font-size: 16px;
	font-weight: bold;
	letter-spacing: 2px;
	color: #c5cee0;
	border: 2px #8593ab;
}
